<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBoxToDo.WinUI.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    Title="发现新版本">

    <local:GlassSurface x:Name="Shell" IconGlyph="&#xE896;" Title="发现新版本">
        <local:GlassSurface.TitleBarRight>
            <Button Click="OnLaterClick" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="稍后">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
        </local:GlassSurface.TitleBarRight>

        <Grid Padding="16,4,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="HintText" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                           Text="下载后会静默覆盖安装，装完自动重启。" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" Background="#0DFFFFFF" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PageButton" Grid.Column="0" Padding="10,5" Background="#0DFFFFFF" BorderThickness="0"
                        Click="OnOpenPageClick" Content="打开发布页" CornerRadius="5" FontSize="12" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,8,0" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                <Button x:Name="LaterButton" Grid.Column="2" Padding="12,5" Background="#0DFFFFFF" BorderThickness="0"
                        Click="OnLaterClick" Content="稍后" CornerRadius="5" FontSize="12" />
                <Button x:Name="InstallButton" Grid.Column="3" Padding="14,5" Background="#3A7FB2FF" BorderThickness="0"
                        Click="OnInstallClick" Content="下载并安装" CornerRadius="5" FontSize="12" />
            </Grid>
        </Grid>
    </local:GlassSurface>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBoxToDo.WinUI.GlassSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- DeskBox 的 BackgroundPlate：只负责描边和一点点提亮，深色玻璃来自窗口材质 -->
        <Border
            x:Name="Plate"
            Background="#0AFFFFFF"
            BorderBrush="#1CFFFFFF"
            BorderThickness="1"
            CornerRadius="14" />

        <Grid x:Name="Layout">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleBar"
                Grid.Row="0"
                Padding="14,0,8,0"
                Background="Transparent">
                <StackPanel
                    x:Name="TitleIdentity"
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center">
                    <FontIcon
                        x:Name="TitleIcon"
                        FontSize="15"
                        Foreground="#E8ECF4"
                        Glyph="&#xE8FD;" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#F2F4F8"
                        Text="待办"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>

                <ContentPresenter
                    x:Name="RightHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>

            <ContentPresenter
                x:Name="BodyHost"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- 缩放热区：DeskBox 同款做法，去掉 WS_THICKFRAME 后自己接管边缘 -->
        <local:ResizeEdge x:Name="ResizeLeft" EdgeBits="1" Width="6" HorizontalAlignment="Left" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeRight" EdgeBits="2" Width="6" HorizontalAlignment="Right" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeTop" EdgeBits="4" Height="6" VerticalAlignment="Top" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeBottom" EdgeBits="8" Height="6" VerticalAlignment="Bottom" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeTopLeft" EdgeBits="5" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeTopRight" EdgeBits="6" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeBottomLeft" EdgeBits="9" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
        <local:ResizeEdge x:Name="ResizeBottomRight" EdgeBits="10" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />
    </Grid>
</UserControl>

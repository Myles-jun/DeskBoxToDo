<Window
    x:Class="DeskBoxToDo.WinUI.ConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="加入待办">

    <Grid x:Name="RootGrid" Padding="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="#F2F4F8" />
            <TextBlock Text="加入待办" FontSize="13" FontWeight="SemiBold" Foreground="#F2F4F8" />
        </StackPanel>

        <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold"
                 Background="#12FFFFFF" BorderThickness="0" CornerRadius="9" Padding="10,8"
                 PlaceholderText="要做什么？" KeyDown="OnTitleKeyDown" />

        <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="10" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" CornerRadius="9" Background="#12FFFFFF" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="日期" FontSize="10.5" Foreground="#9AA1AF" />
                    <CalendarDatePicker x:Name="DateBox" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" CornerRadius="9" Background="#12FFFFFF" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="时间" FontSize="10.5" Foreground="#9AA1AF" />
                    <TimePicker x:Name="TimeBox" ClockIdentifier="24HourClock" Background="Transparent"
                                BorderThickness="0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" CornerRadius="9" Background="#12FFFFFF" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="重复" FontSize="10.5" Foreground="#9AA1AF" />
                    <ComboBox x:Name="RepeatBox" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" CornerRadius="9" Background="#12FFFFFF" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="颜色" FontSize="10.5" Foreground="#9AA1AF" />
                    <ComboBox x:Name="ColorBox" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="子任务（一行一条）" FontSize="11.5" Foreground="#9AA1AF" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="ImportantSwitch" HorizontalAlignment="Right" OffContent="普通" OnContent="重要"
                          MinWidth="0" />
        </Grid>

        <TextBox x:Name="StepsBox" Grid.Row="4" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="90" Background="#12FFFFFF" BorderThickness="0" CornerRadius="9" Padding="10,8"
                 PlaceholderText="第一件事&#x0a;第二件事" />

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="取消" Padding="14,6" HorizontalAlignment="Left"
                    Click="OnCancelClick" Background="#14FFFFFF" BorderThickness="0" CornerRadius="8" />
            <Button x:Name="OkButton" Content="加入待办" Padding="16,6" HorizontalAlignment="Right"
                    Click="OnOkClick" Background="#3A7FB2FF" BorderThickness="0" CornerRadius="8" />
        </Grid>
    </Grid>
</Window>

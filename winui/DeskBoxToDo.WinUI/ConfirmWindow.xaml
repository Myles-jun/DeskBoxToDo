<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBoxToDo.WinUI.ConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    Title="加入待办">

    <local:GlassSurface x:Name="Shell" IconGlyph="&#xE8FD;" Title="加入待办">
        <local:GlassSurface.TitleBarRight>
            <Button Click="OnCancelClick" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="取消（Esc）">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
        </local:GlassSurface.TitleBarRight>

        <Grid Padding="14,2,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="TitleBox"
                Grid.Row="0"
                Margin="0,2,0,0"
                Padding="8,6"
                Background="#0DFFFFFF"
                BorderThickness="0"
                CornerRadius="6"
                FontSize="16"
                FontWeight="SemiBold"
                KeyDown="OnTitleKeyDown"
                PlaceholderText="要做什么？" />

            <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="日期" />
                        <CalendarDatePicker
                            x:Name="DateBox"
                            Background="Transparent"
                            BorderThickness="0"
                            DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="时间" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ComboBox x:Name="HourBox" Width="76" Padding="8,2" FontSize="12.5" Background="Transparent" BorderThickness="0" />
                            <TextBlock Text=":" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="MinuteBox" Width="76" Padding="8,2" FontSize="12.5" Background="Transparent" BorderThickness="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="重复" />
                        <ComboBox x:Name="RepeatBox" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="颜色" />
                        <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Spacing="5" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,8,0,0" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                <StackPanel>
                    <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="提醒" />
                    <ComboBox x:Name="ReminderBox" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="子任务（一行一条）" VerticalAlignment="Center" />
                <ToggleSwitch
                    x:Name="ImportantSwitch"
                    HorizontalAlignment="Right"
                    MinWidth="0"
                    OffContent="普通"
                    OnContent="重要" />
            </Grid>

            <TextBox
                x:Name="StepsBox"
                Grid.Row="4"
                MinHeight="64"
                Margin="0,4,0,0"
                Padding="8,6"
                AcceptsReturn="True"
                Background="#0DFFFFFF"
                BorderThickness="0"
                CornerRadius="6"
                PlaceholderText="第一件事&#x0a;第二件事"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="AiStatus"
                Grid.Row="5"
                Margin="2,4,0,0"
                VerticalAlignment="Top"
                FontSize="11"
                Foreground="{StaticResource AccentSoftBrush}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="6" Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="AiButton"
                    Grid.Column="0"
                    Padding="10,5"
                    Background="#0DFFFFFF"
                    BorderThickness="0"
                    Click="OnAiClick"
                    Content="AI 重解析"
                    CornerRadius="5"
                    FontSize="12" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Padding="12,5"
                    Background="#0DFFFFFF"
                    BorderThickness="0"
                    Click="OnCancelClick"
                    Content="取消"
                    CornerRadius="5"
                    FontSize="12" />
                <Button
                    x:Name="OkButton"
                    Grid.Column="2"
                    Padding="14,5"
                    Background="#3A7FB2FF"
                    BorderThickness="0"
                    Click="OnOkClick"
                    Content="加入待办"
                    CornerRadius="5"
                    FontSize="12" />
            </Grid>
        </Grid>
    </local:GlassSurface>
</Window>

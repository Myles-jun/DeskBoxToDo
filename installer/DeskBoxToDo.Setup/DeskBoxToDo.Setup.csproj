<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName Condition="'$(SetupPayload)'=='0'">Uninstall</AssemblyName>
    <AssemblyName Condition="'$(SetupPayload)'!='0'">DeskBoxToDo_2.0.5_Setup</AssemblyName>
    <RootNamespace>DeskBoxToDo.Setup</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.5</Version>
    <FileVersion>2.0.5.0</FileVersion>
    <Product>DeskBoxToDo</Product>
    <Company>DeskBoxToDo</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup Condition="'$(SetupPayload)'!='0'">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="uninstaller.exe" LogicalName="uninstaller.exe" />
  </ItemGroup>

</Project>

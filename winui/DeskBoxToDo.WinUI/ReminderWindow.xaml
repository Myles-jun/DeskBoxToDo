<Window
    x:Class="DeskBoxToDo.WinUI.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="待办提醒">

    <Grid x:Name="RootGrid" Padding="16,12,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xEA8F;" FontSize="14" Foreground="#E9C46A" />
            <TextBlock Text="待办提醒" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F4F8" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="3" Margin="0,8,0,0">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#F2F4F8"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="DetailText" FontSize="11.5" Foreground="#C4CBD8"
                       TextTrimming="CharacterEllipsis" MaxLines="2" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="点击打开待办" FontSize="10.5" Foreground="#8A8F9A" VerticalAlignment="Center" />
            <Button x:Name="CloseButton" Content="关闭" Padding="8,2" FontSize="11" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0" Foreground="#C9CFDB" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>

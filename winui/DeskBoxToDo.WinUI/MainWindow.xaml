<Window
    x:Class="DeskBoxToDo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    Title="DeskBoxToDo">

    <Grid RequestedTheme="Dark">
        <Rectangle x:Name="TintLayer" IsHitTestVisible="False" />

        <!-- 列表页 -->
        <Grid x:Name="ListPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Height="44" Padding="16,0,10,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8FD;" FontSize="15" Foreground="#F2F4F8" />
                    <TextBlock Text="待办" FontSize="18" FontWeight="SemiBold" Foreground="#F2F4F8" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AddButton" Click="OnAddClick" Width="30" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="#E6EAF2" />
                    </Button>
                    <Button x:Name="MoreButton" Width="30" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#E6EAF2" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="230" Spacing="10" Padding="4">
                                    <TextBlock Text="毛玻璃明暗度" FontSize="12.5" FontWeight="SemiBold" />
                                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100"
                                            StepFrequency="1" ValueChanged="OnBrightnessChanged" />
                                    <TextBlock x:Name="BrightnessLabel" FontSize="11.5" Foreground="#8A8F9A" />
                                    <TextBlock Text="数据来源" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock x:Name="SourceLabel" FontSize="11.5" Foreground="#8A8F9A" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,0,16,6">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel x:Name="TabAll" Tag="all" Tapped="OnTabTapped" Spacing="4">
                        <TextBlock x:Name="TabAllText" FontSize="12.5" Foreground="#8EB8FF" />
                        <Rectangle x:Name="TabAllBar" Height="2" Fill="#7FB2FF" RadiusX="1" RadiusY="1" />
                    </StackPanel>
                    <StackPanel x:Name="TabToday" Tag="today" Tapped="OnTabTapped" Spacing="4">
                        <TextBlock x:Name="TabTodayText" FontSize="12.5" Foreground="#C9CFDB" />
                        <Rectangle x:Name="TabTodayBar" Height="2" Fill="Transparent" RadiusX="1" RadiusY="1" />
                    </StackPanel>
                    <StackPanel x:Name="TabImportant" Tag="important" Tapped="OnTabTapped" Spacing="4">
                        <TextBlock x:Name="TabImportantText" FontSize="12.5" Foreground="#C9CFDB" />
                        <Rectangle x:Name="TabImportantBar" Height="2" Fill="Transparent" RadiusX="1" RadiusY="1" />
                    </StackPanel>
                    <StackPanel x:Name="TabDone" Tag="done" Tapped="OnTabTapped" Spacing="4">
                        <TextBlock x:Name="TabDoneText" FontSize="12.5" Foreground="#C9CFDB" />
                        <Rectangle x:Name="TabDoneBar" Height="2" Fill="Transparent" RadiusX="1" RadiusY="1" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" CornerRadius="9" Background="#12FFFFFF" Margin="12,0,12,8" Padding="10,2">
                <TextBox x:Name="QuickAddBox" BorderThickness="0" Background="Transparent"
                         PlaceholderText="记一条…（回车保存，自动识别时间/重复）"
                         KeyDown="OnQuickAddKeyDown" />
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="9" Margin="16,0,16,8" x:Name="ColorRow" />

            <ListView Grid.Row="4" x:Name="TodoList" Margin="12,0,6,0" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnItemClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,7" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TodoItem">
                        <Grid CornerRadius="10" Padding="10,8" Background="#14FFFFFF"
                              BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="3" CornerRadius="2" Background="{x:Bind AccentColor}" Margin="0,1,10,1" />

                            <CheckBox Grid.Column="1" Tag="{x:Bind Id}" Click="OnCheckBoxClick"
                                      IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                      MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Text}" FontSize="13.5" Foreground="#F2F4F8"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="11" Foreground="#BFC6D4"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>

                            <FontIcon Grid.Column="3" Glyph="&#xE735;" FontSize="14" Margin="8,0,2,0"
                                      Foreground="{x:Bind StarBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="5" Margin="16,6,16,10">
                <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="#C9CFDB" VerticalAlignment="Center" />
                <Button x:Name="ClearDoneButton" Content="清除已完成" HorizontalAlignment="Right" Padding="6,2"
                        FontSize="11.5" Foreground="#C9CFDB" Background="Transparent" BorderThickness="0"
                        Click="OnClearDoneClick" />
            </Grid>
        </Grid>

        <!-- 详情 / 编辑页 -->
        <Grid x:Name="DetailPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="44" Padding="10,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="OnCloseDetail" Width="30" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="#E6EAF2" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="StarButton" Click="OnToggleDetailImportant" Width="30" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon x:Name="StarIcon" Glyph="&#xE734;" FontSize="13" Foreground="#E6EAF2" />
                    </Button>
                    <Button x:Name="DeleteButton" Click="OnDeleteDetail" Width="30" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E6EAF2" />
                    </Button>
                    <Button x:Name="SaveButton" Click="OnSaveDetail" Width="30" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#8EB8FF" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="16,0,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBox x:Name="TitleBox" PlaceholderText="要做什么？" FontSize="19" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="9" Background="#12FFFFFF" Padding="10,7">
                            <StackPanel Spacing="3">
                                <TextBlock Text="日期" FontSize="10.5" Foreground="#9AA1AF" />
                                <CalendarDatePicker x:Name="DateBox" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="9" Background="#12FFFFFF" Padding="10,7">
                            <StackPanel Spacing="3">
                                <TextBlock Text="时间" FontSize="10.5" Foreground="#9AA1AF" />
                                <TimePicker x:Name="TimeBox" ClockIdentifier="24HourClock" Background="Transparent"
                                            BorderThickness="0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="9" Background="#12FFFFFF" Padding="10,7">
                            <StackPanel Spacing="3">
                                <TextBlock Text="重复" FontSize="10.5" Foreground="#9AA1AF" />
                                <ComboBox x:Name="RepeatBox" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="9" Background="#12FFFFFF" Padding="10,7">
                            <StackPanel Spacing="3">
                                <TextBlock Text="颜色" FontSize="10.5" Foreground="#9AA1AF" />
                                <ComboBox x:Name="ColorBox" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="子任务（一行一条）" FontSize="11.5" Foreground="#9AA1AF" />
                        <TextBox x:Name="StepsBox" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                                 Background="#12FFFFFF" BorderThickness="0" CornerRadius="9" Padding="10,8"
                                 PlaceholderText="第一件事&#x0a;第二件事" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="备注" FontSize="11.5" Foreground="#9AA1AF" />
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"
                                 Background="#12FFFFFF" BorderThickness="0" CornerRadius="9" Padding="10,8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="16,6,16,10">
                <TextBlock x:Name="DetailHint" FontSize="11" Foreground="#8A8F9A" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- 自实现缩放用的四条热区（窗口右侧/底部/左下等边缘） -->
        <Border x:Name="ResizeRight" Width="6" HorizontalAlignment="Right" Background="Transparent"
                PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"
                PointerEntered="OnResizeEntered" />
        <Border x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" Background="Transparent"
                PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"
                PointerEntered="OnResizeEntered" />
        <Border x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left" Background="Transparent"
                PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"
                PointerEntered="OnResizeEntered" />
        <Border x:Name="ResizeTop" Height="6" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"
                PointerEntered="OnResizeEntered" />

        <Border IsHitTestVisible="False" BorderBrush="#3AFFFFFF" BorderThickness="1" CornerRadius="9" />
    </Grid>
</Window>

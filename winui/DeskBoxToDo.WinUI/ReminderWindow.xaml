<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBoxToDo.WinUI.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    Title="待办提醒">

    <local:GlassSurface x:Name="Shell" IconGlyph="&#xEA8F;" Title="待办提醒">
        <local:GlassSurface.TitleBarRight>
            <Button Click="OnCloseClick" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </local:GlassSurface.TitleBarRight>

        <Grid Padding="14,0,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                           MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="1">
                <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                           Text="点击卡片打开待办" />
                <Button x:Name="SnoozeButton" HorizontalAlignment="Right" Padding="8,3" FontSize="11"
                        Background="#16FFFFFF" BorderThickness="0" CornerRadius="4"
                        Click="OnSnoozeClick" Content="稍后 10 分钟" />
            </Grid>
        </Grid>
    </local:GlassSurface>
</Window>

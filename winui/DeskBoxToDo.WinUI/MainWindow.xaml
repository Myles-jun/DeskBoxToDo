<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBoxToDo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    Title="DeskBoxToDo">

    <local:GlassSurface x:Name="Shell" IconGlyph="&#xE8FD;" Title="待办">
        <local:GlassSurface.TitleBarRight>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="AddButton"
                    Click="OnAddClick"
                    Style="{StaticResource ChromeIconButton}"
                    ToolTipService.ToolTip="新建待办">
                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                </Button>
                <Button
                    x:Name="MoreButton"
                    Style="{StaticResource ChromeIconButton}"
                    ToolTipService.ToolTip="更多">
                    <FontIcon FontSize="13" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="250" Spacing="10" Padding="2">
                                <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="窗口层级" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="LayerNormalButton" Click="OnLayerNormalClick" Content="浮窗" Style="{StaticResource ChromeTextButton}" />
                                    <Button x:Name="LayerDesktopButton" Click="OnLayerDesktopClick" Content="桌面" Style="{StaticResource ChromeTextButton}" />
                                    <Button x:Name="LayerTopButton" Click="OnLayerTopClick" Content="置顶" Style="{StaticResource ChromeTextButton}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource ChromeFieldLabel}" Margin="0,6,0,0" Text="材质" />
                                <ComboBox x:Name="MaterialBox" HorizontalAlignment="Stretch" SelectionChanged="OnMaterialChanged">
                                    <ComboBoxItem Content="云母（最稳）" Tag="mica" />
                                    <ComboBoxItem Content="亚克力（更通透）" Tag="acrylic" />
                                    <ComboBoxItem Content="亚克力 Thin（最透）" Tag="acrylic-thin" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource ChromeFieldLabel}" Margin="0,6,0,0" Text="毛玻璃明暗度" />
                                <Slider x:Name="BrightnessSlider" Maximum="100" Minimum="0" StepFrequency="1" ValueChanged="OnBrightnessChanged" />
                                <TextBlock x:Name="BrightnessLabel" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />

                                <TextBlock Style="{StaticResource ChromeFieldLabel}" Margin="0,6,0,0" Text="数据来源" />
                                <TextBlock x:Name="SourceLabel" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />

                                <Button Content="设置…" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnSettingsClick" />
                                <Button Content="打开日志" HorizontalAlignment="Stretch" Click="OnOpenLogClick" />
                                <Button Content="隐藏到托盘" HorizontalAlignment="Stretch" Click="OnCloseWindowClick" />
                                <Button Content="退出程序" HorizontalAlignment="Stretch" Click="OnExitAppClick" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:GlassSurface.TitleBarRight>

        <Grid x:Name="RootGrid">
            <Grid x:Name="ListPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Height="34"
                    Margin="14,2,14,8"
                    Background="#08FFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="7">
                    <Grid Padding="2" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TabAll" Grid.Column="0" Tag="all" Click="OnTabClick" Style="{StaticResource TabButtonStyle}">
                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TabAllText" FontSize="13" Text="全部 0" />
                                <Rectangle x:Name="TabAllBar" Width="18" Height="2" Fill="Transparent" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabToday" Grid.Column="1" Tag="today" Click="OnTabClick" Style="{StaticResource TabButtonStyle}">
                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TabTodayText" FontSize="13" Text="今天 0" />
                                <Rectangle x:Name="TabTodayBar" Width="18" Height="2" Fill="Transparent" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabImportant" Grid.Column="2" Tag="important" Click="OnTabClick" Style="{StaticResource TabButtonStyle}">
                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TabImportantText" FontSize="13" Text="重要 0" />
                                <Rectangle x:Name="TabImportantBar" Width="18" Height="2" Fill="Transparent" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabDone" Grid.Column="3" Tag="done" Click="OnTabClick" Style="{StaticResource TabButtonStyle}">
                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TabDoneText" FontSize="13" Text="已完成 0" />
                                <Rectangle x:Name="TabDoneBar" Width="18" Height="2" Fill="Transparent" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel x:Name="ColorRow" Grid.Row="1" Margin="14,0,14,8" Orientation="Horizontal" Spacing="4" />

                <Border x:Name="QuickAddBorder" Grid.Row="2" MinHeight="42" Margin="14,0,14,8" Background="#0DFFFFFF" CornerRadius="6">
                    <Grid Padding="10,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="12" Glyph="&#xE710;" />
                        <TextBox
                            x:Name="QuickAddBox"
                            Grid.Column="1"
                            MinHeight="40"
                            Padding="0,10,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13.5"
                            KeyDown="OnQuickAddKeyDown"
                            PlaceholderText="记一条…（回车保存）" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Spacing="4"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="没有任务" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="添加一个任务开始吧。" />
                    </StackPanel>

                <ListView
                    x:Name="TodoList"
                    Grid.Row="3"
                    Margin="12,0,8,0"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TodoItem">
                            <Grid
                                x:Name="ItemRoot"
                                MinHeight="50"
                                Margin="2,2,4,2"
                                Padding="8,6"
                                Background="#0DFFFFFF"
                                CornerRadius="4"
                                PointerEntered="ItemRoot_PointerEntered"
                                PointerExited="ItemRoot_PointerExited"
                                Tapped="ItemRoot_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    MinWidth="20"
                                    MinHeight="20"
                                    Margin="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="OnCheckBoxClick"
                                    IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                    Tag="{x:Bind Id}" />

                                <Border
                                    Grid.Column="1"
                                    Width="3"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind AccentColor}"
                                    CornerRadius="1.5" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="13.5"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind Text}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{x:Bind SubtitleBrush, Mode=OneWay}"
                                        MaxLines="1"
                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <FontIcon
                                    Grid.Column="3"
                                    Margin="6,0,2,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E9C46A"
                                    Glyph="&#xE735;"
                                    Visibility="{x:Bind StarVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>

                <Grid Grid.Row="4" Margin="16,6,12,10">
                    <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11.5" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="LayerButton" Click="OnCycleLayerClick" Style="{StaticResource ChromeTextButton}" />
                        <Button x:Name="ClearDoneButton" Click="OnClearDoneClick" Content="清除已完成" Style="{StaticResource ChromeTextButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- 详情 / 编辑页 -->
            <Grid x:Name="DetailPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="40" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Click="OnCloseDetail" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="返回">
                            <FontIcon FontSize="13" Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock x:Name="DetailTitle" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="StarButton" Click="OnToggleDetailImportant" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="重要">
                            <FontIcon x:Name="StarIcon" FontSize="13" Glyph="&#xE734;" />
                        </Button>
                        <Button x:Name="DeleteButton" Click="OnDeleteDetail" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="删除">
                            <FontIcon FontSize="13" Glyph="&#xE74D;" />
                        </Button>
                        <Button x:Name="SaveButton" Click="OnSaveDetail" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="保存">
                            <FontIcon FontSize="13" Glyph="&#xE73E;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="14,0,14,4" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBox
                            x:Name="TitleBox"
                            MinHeight="40"
                            Padding="2,6"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            PlaceholderText="要做什么？"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="日期" />
                                    <CalendarDatePicker
                                        x:Name="DateBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="时间" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ComboBox x:Name="HourBox" Width="76" Padding="8,2" FontSize="12.5" Background="Transparent" BorderThickness="0" />
                                        <TextBlock Text=":" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ComboBox x:Name="MinuteBox" Width="76" Padding="8,2" FontSize="12.5" Background="Transparent" BorderThickness="0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="重复" />
                                    <ComboBox x:Name="RepeatBox" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="颜色" />
                                    <StackPanel x:Name="DetailColorHost" Spacing="3" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="9,6" Background="#0DFFFFFF" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="提醒" />
                                <ComboBox x:Name="ReminderBox" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="子任务（勾选已完成，一行一条）" />
                            <StackPanel x:Name="StepsChecklist" Spacing="1" Visibility="Collapsed" />
                            <TextBox
                                x:Name="StepsBox"
                                MinHeight="72"
                                AcceptsReturn="True"
                                Background="#0DFFFFFF"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="8,6"
                                PlaceholderText="第一件事&#x0a;第二件事"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="备注" />
                            <TextBox
                                x:Name="NotesBox"
                                MinHeight="80"
                                AcceptsReturn="True"
                                Background="#0DFFFFFF"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="8,6"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="16,6,16,10">
                    <TextBlock x:Name="DetailHint" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </local:GlassSurface>
</Window>

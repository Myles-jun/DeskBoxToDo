<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBoxToDo.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskBoxToDo.WinUI"
    Title="设置">

    <local:GlassSurface x:Name="Shell" IconGlyph="&#xE713;" Title="设置">
        <local:GlassSurface.TitleBarRight>
            <Button Click="OnCancelClick" Style="{StaticResource ChromeIconButton}" ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
        </local:GlassSurface.TitleBarRight>

        <Grid Padding="14,2,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="默认提醒时间（消息里没写时间时用它）" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="HourBox" Width="88" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" Text="时" />
                            <ComboBox x:Name="MinuteBox" Width="88" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" Text="分" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="数据来源" />
                        <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="独立数据（DeskBoxToDo 自己的 todo.json）" />
                            <ComboBoxItem Content="DeskBox 小组件数据（与 DeskBox 同步）" />
                        </ComboBox>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" Text="切换后需要重启程序生效。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="全局热键（选中文字后按它）" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="10,7" Background="#0DFFFFFF" CornerRadius="6">
                                <TextBlock x:Name="HotkeyLabel" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="Alt + Q" />
                            </Border>
                            <Button x:Name="RecordButton" Grid.Column="1" Content="录制" Padding="14,6"
                                    Background="#0DFFFFFF" BorderThickness="0" CornerRadius="5" FontSize="12"
                                    Click="OnRecordHotkeyClick" />
                        </Grid>
                        <TextBlock x:Name="HotkeyHint" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="点「录制」后按下想用的组合键（必须带 Ctrl/Alt/Shift/Win）。" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="AutostartSwitch" MinWidth="0" Margin="0,6,0,0"
                                      OffContent="开机自动启动：关" OnContent="开机自动启动：开" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="外观（所有窗口统一）" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="圆角" />
                            <ComboBox x:Name="RadiusBox" Grid.Column="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="跟随系统（8，平滑）" Tag="-1" />
                                <ComboBoxItem Content="直角（0）" Tag="0" />
                                <ComboBoxItem Content="小圆角（4，平滑）" Tag="4" />
                                <ComboBoxItem Content="标准圆角（8，平滑）" Tag="8" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="明暗度" />
                            <Slider x:Name="DensitySlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" />
                        </Grid>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="改完点「保存」立刻应用到已打开的窗口。" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource ChromeFieldLabel}" Text="AI 重解析（可留空，默认用 DeepSeek）" />
                        <TextBox x:Name="AiBaseBox" PlaceholderText="接口地址，如 https://api.deepseek.com/v1" />
                        <TextBox x:Name="AiModelBox" PlaceholderText="模型，如 deepseek-chat" />
                        <PasswordBox x:Name="AiKeyBox" PlaceholderText="API Key（sk-…）" />
                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="默认关闭，只有点「AI 重解析」时才联网。" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Button Content="取消" HorizontalAlignment="Left" Padding="14,6" Click="OnCancelClick"
                        Background="#0DFFFFFF" BorderThickness="0" CornerRadius="5" FontSize="12" />
                <Button Content="保存" HorizontalAlignment="Right" Padding="16,6" Click="OnSaveClick"
                        Background="#3A7FB2FF" BorderThickness="0" CornerRadius="5" FontSize="12" />
            </Grid>
        </Grid>
    </local:GlassSurface>
</Window>

<Window
    x:Class="DeskBoxToDo.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">

    <Grid x:Name="RootGrid" Padding="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#F2F4F8" />
            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Foreground="#F2F4F8" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="默认提醒时间（没写时间时用它）" FontSize="11.5" Foreground="#9AA1AF" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="HourBox" Width="90" />
                <TextBlock Text="时" VerticalAlignment="Center" Foreground="#C9CFDB" />
                <ComboBox x:Name="MinuteBox" Width="90" />
                <TextBlock Text="分" VerticalAlignment="Center" Foreground="#C9CFDB" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="数据来源" FontSize="11.5" Foreground="#9AA1AF" />
            <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="独立数据（DeskBoxToDo 自己的 todo.json）" />
                <ComboBoxItem Content="DeskBox 小组件数据（与 DeskBox 同步）" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="全局热键（选中文字后按它）" FontSize="11.5" Foreground="#9AA1AF" />
            <ComboBox x:Name="HotkeyBox" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="AI 重解析（可留空，默认用 DeepSeek）" FontSize="11.5" Foreground="#9AA1AF" />
            <TextBox x:Name="AiBaseBox" PlaceholderText="接口地址，如 https://api.deepseek.com/v1" />
            <TextBox x:Name="AiModelBox" PlaceholderText="模型，如 deepseek-chat" />
            <PasswordBox x:Name="AiKeyBox" PlaceholderText="API Key（sk-…）" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="修改数据来源后需要重启程序生效。" FontSize="10.5" Foreground="#8A8F9A"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Button Content="取消" Padding="14,6" HorizontalAlignment="Left" Click="OnCancelClick"
                    Background="#14FFFFFF" BorderThickness="0" CornerRadius="8" />
            <Button Content="保存" Padding="16,6" HorizontalAlignment="Right" Click="OnSaveClick"
                    Background="#3A7FB2FF" BorderThickness="0" CornerRadius="8" />
        </Grid>
    </Grid>
</Window>
